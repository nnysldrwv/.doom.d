# -*- mode: snippet -*-
# name: 券商普通账户买入 ETF
# key: buy
# group: beancount
# 用法：buy TAB → 日期(今天) → 基金代码(默认 513870) → 份额 → 成交单价
#       fund_name / asset_category / 账户路径 / 成交额 / 佣金 全部自动带出。
#       佣金 = max(5, 成交额 × 0.5‱)，2026-06-10 后实测有效。
#       新标的先加到 .yas-setup.el 的 bc-etf-table，否则名称/路径会是空的。
# --
${1:`(format-time-string "%Y-%m-%d")`} * "买入 ${5:$(bc-etf (yas-field-value 2) 'name)} (${2:513870})"
  fund_code: "$2"
  fund_name: "${5:$(bc-etf (yas-field-value 2) 'name)}"
  asset_category: "${2:$(bc-etf yas-text 'cat)}"
  trade_price: "${4:0.000} CNY"
  trade_value: "${4:$(bc-value (yas-field-value 3) yas-text)} CNY"
  Assets:Investment:Broker:Normal:${2:$(bc-etf yas-text 'cls)}:ETF$2  ${3:0} ETF$2 {{${4:$(bc-value (yas-field-value 3) yas-text)} CNY}}
  Expenses:Investment:Fees  ${4:$(bc-fee (bc-value (yas-field-value 3) yas-text))} CNY
  Assets:Investment:Broker:Normal:Cash
$0
